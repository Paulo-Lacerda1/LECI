#include <detpic32.h>

void delay(unsigned int ms);
void send2display(unsigned char value);

volatile unsigned char displayValue = 0;

int main(void)
{
    int avg;
    int value;
    int *p;

    // =========================
    // Configuração do LED RE1
    // =========================
    TRISEbits.TRISE1 = 0;   // RE1 como saída
    LATEbits.LATE1 = 0;     // valor inicial 0

    // =========================
    // Configuração do display
    // RB8-RB14 -> segmentos
    // RD5 -> display low
    // RD6 -> display high
    // =========================
    TRISB = TRISB & 0x80FF;   // RB8-RB14 como saída
    TRISD = TRISD & 0xFF9F;   // RD5 e RD6 como saída

    // =========================
    // Configuração ADC (AN4/RB4)
    // =========================
    TRISBbits.TRISB4 = 1;     // RB4 desligado da saída digital
    AD1PCFGbits.PCFG4 = 0;    // RB4 como entrada analógica

    AD1CON1bits.SSRC = 7;     // auto-convert
    AD1CON1bits.CLRASAM = 1;  // para após interrupção
    AD1CON3bits.SAMC = 16;    // tempo de amostragem
    AD1CON2bits.SMPI = 1;     // 2 conversões por amostra (N-1 = 1)
    AD1CHSbits.CH0SA = 4;     // canal AN4
    AD1CON1bits.ON = 1;       // liga ADC

    while(1)
    {
        // Iniciar conversão
        AD1CON1bits.ASAM = 1;

        // Esperar fim de conversão
        while(IFS1bits.AD1IF == 0);

        // Ler 2 resultados e calcular média
        p = (int *)(&ADC1BUF0);
        avg = (p[0] + p[4]) / 2;

        // Mostrar média no PC em hexadecimal com 3 dígitos
        printInt(avg, 16 | (3 << 16));
        putChar('\n');

        // Escalar média para 0..9
        value = (avg * 9) / 1023;
        displayValue = value;

        // Alternar LED RE1
        LATEbits.LATE1 = !LATEbits.LATE1;

        // Limpar flag do ADC
        IFS1bits.AD1IF = 0;

        // Durante ~167 ms manter display refrescado
        // para evitar flicker
        int i;
        for(i = 0; i < 167; i++) {
            send2display(displayValue);
            delay(1);
        }
    }

    return 0;
}

void send2display(unsigned char value)
{
    static const char disp7Scodes[] =
    {
        0x3F, 0x06, 0x5B, 0x4F,
        0x66, 0x6D, 0x7D, 0x07,
        0x7F, 0x6F, 0x77, 0x7C,
        0x39, 0x5E, 0x79, 0x71
    };

    // Só queremos usar o display menos significativo
    LATDbits.LATD5 = 1;   // low ON
    LATDbits.LATD6 = 0;   // high OFF

    LATB = (LATB & 0x80FF) | (disp7Scodes[value] << 8);
}

void delay(unsigned int ms)
{
    resetCoreTimer();
    while(readCoreTimer() < 20000 * ms);
}
